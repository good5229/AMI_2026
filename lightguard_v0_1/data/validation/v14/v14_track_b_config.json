  "blocked_status": "BLOCKED_PROVENANCE_OR_MANIFEST",
  "activation_decision": "ELIGIBLE_CONTROLLED_MECHANISM_ONLY",
  "representative_run_selection": {
    "rule": "Pre-outcome deterministic stratified set: all 10 NC runs plus 10 runs per A/B/C severity, covering frequency classes 1/2/3 with sample ids 1/2/3 and the frequency-1 sample 4; sorted by immutable run_id. No detector score or label outcome was accessed.",
    "strata_requirement": "The retained subset must contain at least 5 control runs and at least 5 runs in each manifest-defined low, medium, and high severity stratum. If metadata cannot support this rule, stop as BLOCKED_METADATA_UNAVAILABLE rather than choosing examples manually.",
    "raw_data_policy": "Only selected official files may be downloaded after source, licence, size, file list, and hash method are recorded. Raw files remain outside Git.",
    "bounded_observation": "For every selected run, fetch only the first 16777216 bytes by HTTP Range, discard an incomplete trailing row, and mark the observation PARTIAL_RUN_PREFIX. This byte bound was chosen before detector scores to avoid the 20.2 GB full download. No whole-run coverage claim is permitted."
  },
  "run_split": {
    "fit": "SHA-256(run_id + ':v14-b-split') mod 5 in {0,1,2}",
    "calibration": "SHA-256(run_id + ':v14-b-split') mod 5 == 3",
    "confirmatory": "SHA-256(run_id + ':v14-b-split') mod 5 == 4",
    "balance_requirement": "Each split must contain control and injection runs plus every eligible severity stratum. If not, report NOT_EVALUABLE_SPLIT_BALANCE without moving runs."
  },
