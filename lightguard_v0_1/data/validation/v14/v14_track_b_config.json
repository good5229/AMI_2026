    "PMC-3": "PARTIAL_TWO_CHANNEL_CURRENT_CONTRAST_ONLY",
    "PMC-4": "AVAILABLE_PENDING_MANIFEST_VERIFICATION",
    "PMC-5": "AVAILABLE_PENDING_MANIFEST_VERIFICATION"
  },
  "baseline_and_episode_rules": {
    "baseline": "Use only manifest-documented pre-injection control samples from the same run. If no such interval is documented, PMC-1 remains SURROGATE_ONLY and direct baseline analysis is disabled.",
    "episode": "A labelled contiguous injection interval is one episode; no point row is an independent outcome.",
    "matched_control": "For each confirmatory injection episode, choose the earliest eligible same-run control interval of equal duration separated by at least one episode duration, after ordering candidates by SHA-256(run_id + episode_start + ':v14-b-control:' + seed). Controls must be fixed before score calculation."
  },
  "candidates": [
    "PMC-C1",
